{
  "name": "dream-game",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:config && npm run test:games && npm run test:functions && npm run audit",
    "test:games": "node --test supabase/functions/_shared/games/tests/engines.test.ts",
    "test:db": "supabase test db",
    "test:functions": "node --import ./supabase/functions/tests/loader.mjs --test supabase/functions/tests/functions.test.ts",
    "audit": "python3 tests/crossref_audit.py",
    "test:ui": "sh tests/e2e/build.sh && python3 tests/e2e/ui_tests.py",
    "prebuild": "node scripts/check-env.mjs",
    "check:env": "node scripts/check-env.mjs",
    "test:config": "node --test tests/config.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
